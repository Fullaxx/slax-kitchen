# Is a tool installed? mkfs.* lives in /usr/sbin, which a non-login PATH can lack --
# qemu_boot.py and ci/tier-c.sh look there too, so a tool they would find is not MISS here.
have_tool() {
    have "$1" && return 0
    case "$1" in mkfs.*) PATH="$PATH:/usr/sbin:/sbin:/usr/local/sbin" have "$1" ;; *) return 1 ;; esac
}

# The package that puts a tool on PATH, read from TOOLS. A tool the table does not list is
# assumed to share its package's name -- which python3, the one such caller, does.
tool_pkg() {
    _tp=$(echo "$TOOLS" | awk -F'|' -v t="$1" '$1 == t { print $2; exit }')
    printf '%s' "${_tp:-$1}"
}

doctor_tools() {
    printf '%sTools%s\n' "$B" "$O"
    missing=0
    echo "$TOOLS" | while IFS='|' read -r bin pkg why; do
        if have_tool "$bin"; then
            printf '  %sok%s   %-20s %s%s%s\n' "$G" "$O" "$bin" "$D" "$why" "$O"
        else
            printf '  %sMISS%s %-20s %s(apt-get install %s)%s\n' "$R" "$O" "$bin" "$D" "$pkg" "$O"
        fi
    done
    # recount outside the subshell
    missing=0
    for bin in $(echo "$TOOLS" | cut -d'|' -f1); do
        have_tool "$bin" || missing=$((missing+1))
    done
    [ "$missing" -eq 0 ] || printf '  %s%d tool(s) missing%s\n' "$Y" "$missing" "$O"
    # Published rather than returned: --strict needs it, and `doctor` with no flags
    # must still exit 0 on an incomplete machine -- telling you what you are missing
    # is the whole job, and a non-zero exit would make it look like doctor broke.
    DOCTOR_MISSING=$missing
    return 0
}

# Probe kernel/container capabilities. Echoes one "name=yes|no" per line.
doctor_caps() {
    probe_dir=$(mktemp -d)
    if mount -t tmpfs tmpfs "$probe_dir" >/dev/null 2>&1; then
        echo "mount=yes"; umount "$probe_dir" 2>/dev/null
    else echo "mount=no"; fi
    if unshare -U true >/dev/null 2>&1; then echo "userns=yes"; else echo "userns=no"; fi
    # WRITABLE, not readable. KVM is driven through ioctls on a read-write descriptor, and
    # every boot path decides or reports with a write check -- qemu_boot.py's -enable-kvm,
    # and so every ledger row's accel; tier-c.sh's and tools/qemu/boot.py's banners. This
    # was -r, so a /dev/kvm the account could read but not write (a 0644 node) had doctor
    # reporting "KVM (fast)" about runs that went to TCG. Reproduced with such a node as
    # uid 65534: "ok kvm", "KVM (fast)", "kvm=yes".
    if [ -c /dev/kvm ] && [ -w /dev/kvm ]; then echo "kvm=yes"; else echo "kvm=no"; fi
    if mknod "$probe_dir/n" c 1 3 >/dev/null 2>&1; then echo "mknod=yes"; rm -f "$probe_dir/n"
    else echo "mknod=no"; fi
    if chroot / /bin/true >/dev/null 2>&1; then echo "chroot=yes"; else echo "chroot=no"; fi
    if [ -e /dev/loop-control ]; then echo "loop=yes"; else echo "loop=no"; fi
    rmdir "$probe_dir" 2>/dev/null
}

doctor_tier() {
    caps=$1
    cap() { echo "$caps" | grep -q "^$1=yes"; }
    printf '\n%sCapabilities%s\n' "$B" "$O"
    echo "$caps" | while IFS='=' read -r name val; do
        if [ "$val" = yes ]; then printf '  %sok%s   %s\n' "$G" "$O" "$name"
        else printf '  %sno%s   %s\n' "$Y" "$O" "$name"; fi
    done

    printf '\n%sWhat this machine can run%s\n' "$B" "$O"
    printf '  %so%s  unprivileged recipes .............. %syes%s  (bundles, boot, ISO, rootcopy)\n' "$B" "$O" "$G" "$O"

    # The initramfs holds seven device nodes; a cpio without CAP_MKNOD turns them into
    # empty regular files and the repacked image cannot open its own console.
    if cap mknod; then
        printf '  %sm%s  initramfs recipes ................ %syes%s\n' "$B" "$O" "$G" "$O"
    else
        printf '  %sm%s  initramfs recipes ................ %sno%s  needs mknod (run as root)\n' "$B" "$O" "$R" "$O"
    fi

    # bundle.packages needs chroot + mknod only. Measured: apt-get update and a full
    # apt-get install with maintainer scripts both exit 0 inside an extracted 01-core.sb
    # with no /proc mounted, so CAP_SYS_ADMIN is NOT required. proot is not a fallback --
    # it does not translate statx(), so stat silently reads the host filesystem.
    if cap chroot && cap mknod; then
        printf '  %sd%s  bundle.packages (real chroot) .... %syes%s\n' "$B" "$O" "$G" "$O"
    else
        printf '  %sd%s  bundle.packages .................. %sno%s  needs chroot + mknod\n' "$B" "$O" "$R" "$O"
    fi

    # THE BOOT HOST ANSWERS THIS QUESTION FIRST, because when one is configured the local
    # /dev/kvm and the local qemu have nothing to do with where a boot test runs -- and
    # reporting "no qemu" on a machine whose boots all succeed elsewhere is a true fact
    # about the wrong machine. Bounded by a timeout: doctor must stay fast and must not
    # hang on an unreachable host, so a slow answer becomes "could not be reached" rather
    # than a wait. The detail lives in `kitchen boot-host check`.
    _bh=$(python3 "$REPO_ROOT/lib/boot_host.py" active 2>/dev/null)
    if [ -n "$_bh" ]; then
        if _bhc=$(timeout 20 python3 "$REPO_ROOT/lib/boot_host.py" check 2>&1); then
            _bhq=$(printf '%s\n' "$_bhc" | awk '/qemu-system-x86_64 /{print $NF; exit}')
            printf '  %sk%s  boot tests ....................... %sKVM on %s%s (qemu %s)\n' \
                "$B" "$O" "$G" "$_bh" "$O" "${_bhq:-?}"
        else
            printf '  %sk%s  boot tests ....................... %sboot host %s unusable%s\n' \
                "$B" "$O" "$R" "$_bh" "$O"
            printf '       %srun `kitchen boot-host check` for the reason%s\n' "$D" "$O"
        fi
    elif cap kvm; then
        printf '  %sk%s  boot tests ....................... %sKVM (fast)%s\n' "$B" "$O" "$G" "$O"
    elif have qemu-system-x86_64 && [ -e /dev/kvm ]; then
        printf '  %sk%s  boot tests ....................... %sTCG only%s (/dev/kvm is here but not writable by this account)\n' "$B" "$O" "$Y" "$O"
    elif have qemu-system-x86_64; then
        printf '  %sk%s  boot tests ....................... %sTCG only%s (10-20x slower; Tier B ok, Tier C -> host)\n' "$B" "$O" "$Y" "$O"
    else
        printf '  %sk%s  boot tests ....................... %sno qemu%s\n' "$B" "$O" "$R" "$O"
    fi

    # A device that is here but not writable is not a missing device, and the fix differs
    # by cause: telling someone to add --device /dev/kvm to a container that already has it,
    # or to join a group that cannot write it either, sends them after the wrong thing.
    if ! cap kvm && [ -e /dev/kvm ]; then
        printf '\n  %sNote:%s /dev/kvm is here, but this account cannot write it, so boots run%s\n' "$D" "$O" "$O"
        _kg=$(stat -c %G /dev/kvm 2>/dev/null) || _kg=kvm
        # Would the permission bits let this session write it? Root; a mode anyone may
        # write; the owner's bit, for its owner; the group's, for a session in that group.
        # If they would and the write is still refused, no permission bit is the cause --
        # and "join the group" is wrong advice for an account already in it, which is how
        # the first version of this note read.
        _kb=no
        if [ "$(id -u)" = 0 ] \
            || [ -n "$(find /dev/kvm -maxdepth 0 -perm -002 2>/dev/null)" ] \
            || [ -n "$(find /dev/kvm -maxdepth 0 -perm -200 -user "$(id -u)" 2>/dev/null)" ] \
            || { [ -n "$(find /dev/kvm -maxdepth 0 -perm -020 2>/dev/null)" ] \
                 && id -Gn 2>/dev/null | tr ' ' '\n' | grep -Fqx "$_kg"; }; then
            _kb=yes
        fi
        if [ "$_kb" = yes ]; then
            # Measured in an unprivileged Docker container: a /dev/kvm node made there with
            # mknod, mode 0666, refused root and everyone else -- the device cgroup admits
            # Docker's default set and whatever was passed with --device, and nothing made
            # afterwards.
            printf '  %sunder TCG. Its permissions allow this account, so something else refuses%s\n' "$D" "$O"
            printf '  %sit: usually a container device cgroup, which admits only --device /dev/kvm.%s\n' "$D" "$O"
        elif [ -n "$(find /dev/kvm -maxdepth 0 -perm -020 2>/dev/null)" ]; then
            printf '  %sunder TCG. Add the account to group %s (usermod -aG %s <user>) and log in%s\n' "$D" "$_kg" "$_kg" "$O"
            printf '  %sagain: a session keeps the groups it started with.%s\n' "$D" "$O"
        else
            # Only suggest a group that can write the device. Joining the owning group of a
            # 0644 node changes nothing -- and for root:root it would be advice to join root.
            _km=$(stat -c %a /dev/kvm 2>/dev/null) || _km='?'
            printf '  %sunder TCG. Its mode (%s) lets no group write it; the usual setup is 0660%s\n' "$D" "$_km" "$O"
            printf '  %sroot:kvm, from the distribution'"'"'s udev rule, with the account in group kvm.%s\n' "$D" "$O"
        fi
    elif [ -n "$_bh" ]; then
        # NOT the note below. "only the full boot matrix is blocked here" and "adding
        # --device /dev/kvm turns 5-15 min into ~30 s" are both false on a machine whose
        # boots already run on a KVM host: nothing is blocked and nothing would get
        # faster. Saying it anyway would send someone to reconfigure a container to fix a
        # problem they do not have.
        printf '\n  %sNote:%s this machine has no KVM and does not need one -- boot tests%s\n' \
            "$D" "$O" "$O"
        printf '  %srun on %s (boot-host.ini). `kitchen test --local` boots here instead.%s\n' \
            "$D" "$_bh" "$O"
    elif ! cap kvm; then
        printf '\n  %sNote:%s only the full boot matrix is blocked here. Adding%s\n' "$D" "$O" "$O"
        printf '  %s  --device /dev/kvm%s\n' "$D" "$O"
        printf '  %sturns a 5-15 min boot-to-desktop run into ~30 s. Everything else,%s\n' "$D" "$O"
        printf '  %sbundle.packages included, already runs here.%s\n' "$D" "$O"
        printf '  %sOr point boot tests at a machine that has KVM: boot-host.example.ini.%s\n' \
            "$D" "$O"
    fi
}

# Version of one tool, in one line. Every one of these spells it differently, and a
# couple read stdin when confused, so: no shared flag, stdin closed, and a timeout --
# `kitchen doctor` must never be the command that hangs.
tool_version() {
    _t=$1
    case "$_t" in
        mksquashfs|unsquashfs) _o=$(timeout 5 "$_t" -version </dev/null 2>&1) ;;
        xorriso)               _o=$(timeout 5 xorriso -version </dev/null 2>&1 \
                                    | grep -i 'xorriso version' | head -1) ;;
        7z)                    _o=$(timeout 5 7z </dev/null 2>&1 | grep -i '^7-Zip' | head -1) ;;
        isohybrid|extlinux|syslinux)
                               _o=$(timeout 5 "$_t" --version </dev/null 2>&1) ;;
        # dosfstools prints its usage on --help and the version only at the end.
        mkfs.vfat)             _o=$(timeout 5 mkfs.vfat --help </dev/null 2>&1 \
                                    | grep -iE '^mkfs\.fat [0-9]' | head -1) ;;
        mcopy)                 _o=$(timeout 5 mcopy -V </dev/null 2>&1 | head -1) ;;
        # -V, not --version, which e2fsprogs does not take; and /usr/sbin, as have_tool.
        mkfs.ext4)             _o=$(PATH="$PATH:/usr/sbin:/sbin" timeout 5 mkfs.ext4 -V \
                                    </dev/null 2>&1 | head -1) ;;
        # ShellCheck prints a banner first; the version is on the second line.
        shellcheck)            _o="shellcheck $(timeout 5 shellcheck --version </dev/null 2>&1 \
                                    | sed -n 's/^version: //p' | head -1)" ;;
        *)                     _o=$(timeout 5 "$_t" --version </dev/null 2>&1) ;;
    esac
    printf '%s' "$(printf '%s' "$_o" | head -1 | cut -c1-58)"
}

# Two toolchain facts decide correctness rather than convenience, and doctor asserted
# both in prose while testing neither. The xz row's own description says "must support
# --check=crc32" -- the kernel's decoder cannot do CRC64, which is xz's default, so an
# initramfs built with the wrong check is a kernel that will not boot.
doctor_toolchain() {
    if printf x | timeout 5 xz --check=crc32 -c >/dev/null 2>&1; then
        echo "xz --check=crc32: yes"
    else
        echo "xz --check=crc32: NO -- initramfs recipes will build an unbootable image"
    fi
    _sq=$(timeout 5 mksquashfs -version </dev/null 2>&1 | head -1 | sed -n 's/.*version \([0-9][0-9.]*\).*/\1/p')
    if [ -n "${_sq:-}" ]; then
        _maj=${_sq%%.*}; _rest=${_sq#*.}; _min=${_rest%%.*}
        if [ "${_maj:-0}" -gt 4 ] || { [ "${_maj:-0}" -eq 4 ] && [ "${_min:-0}" -ge 2 ]; }; then
            echo "squashfs-tools >= 4.2: yes ($_sq)"
        else
            echo "squashfs-tools >= 4.2: NO ($_sq) -- xz compression support is not reliable"
        fi
    else
        echo "squashfs-tools >= 4.2: unknown (mksquashfs not found)"
    fi
    # The third one. containers/README.md has always DECLARED a floor of python3 >= 3.9
    # and claimed doctor asserted it; doctor did not, so the floor was prose. It matters:
    # 3.9 is what lets lib/ use builtin generics, and the floor is also what decides which
    # stdlib APIs a fix may reach for. A proposed fix for GHSA-p2w2-qh4r-jr53 wanted
    # tarfile's extractall(filter=...), which needs 3.11.4+ -- out of bounds here, and it
    # would have been a TypeError on debian:12's 3.11.2, one of our two container bases.
    # An unchecked floor cannot refuse that; this can.
    _py=$(timeout 5 python3 -c 'import sys; print("%d %d" % sys.version_info[:2])' 2>/dev/null)
    if [ -n "${_py:-}" ]; then
        _pymaj=${_py%% *}; _pymin=${_py##* }
        if [ "$_pymaj" -gt 3 ] || { [ "$_pymaj" -eq 3 ] && [ "$_pymin" -ge 9 ]; }; then
            echo "python3 >= 3.9: yes ($_pymaj.$_pymin)"
        else
            echo "python3 >= 3.9: NO ($_pymaj.$_pymin) -- lib/ uses builtin generics (PEP 585)"
        fi
    else
        echo "python3 >= 3.9: unknown (python3 did not run)"
    fi
    # The fourth one. apt's python3-yaml, python3-jsonschema and python3-pyflakes are
    # invisible to a python3 that resolves into a venv, and the failure surfaces as a
    # gate that cannot run rather than as a missing package. Import them, the same way
    # lib/validate.py does, rather than asking dpkg.
    #
    # pyflakes is here rather than in TOOLS above because it went in TOOLS first and
    # broke both container jobs: `have pyflakes` passed on a machine with a pip venv and
    # failed in the container, where python3-pyflakes ships the module and the binary
    # comes from a separate package (pyflakes3 on ubuntu:24.04). ci/checks/35-pyflakes.sh
    # runs `python3 -m pyflakes`, so this asks the question that gate actually asks.
    _pymiss=
    for _m in yaml jsonschema pyflakes; do
        timeout 5 python3 -c "import $_m" >/dev/null 2>&1 || _pymiss="$_pymiss $_m"
    done
    if [ -z "$_pymiss" ]; then
        echo "python3 imports yaml + jsonschema + pyflakes: yes"
    else
        echo "python3 imports yaml + jsonschema + pyflakes: NO --$_pymiss not importable"
        echo "  (a venv python3 cannot see apt's python3-yaml / python3-jsonschema /"
        echo "   python3-pyflakes: pip install PyYAML jsonschema pyflakes, or use the"
        echo "   system python3)"
    fi
}

# One pasteable block, no colour, with VERSIONS. This is what a bug report should
# carry: "it works here and not there" is almost always a tool version or a missing
# kernel capability, and neither is visible from the outside.
doctor_report() {
    echo "--- kitchen doctor --report ---"
    echo "kitchen:  $(kitchen_version)"
    echo "repo:     $REPO_ROOT"
    echo "uname:    $(uname -srmo 2>/dev/null || uname -a)"
    if [ -r /etc/os-release ]; then
        echo "os:       $(. /etc/os-release 2>/dev/null; printf '%s' "${PRETTY_NAME:-unknown}")"
    fi
    echo "uid:      $(id -u) ($(id -un 2>/dev/null || echo '?'))"
    echo "python:   $(python3 -V 2>&1)"
    echo
    echo "tools:"
    echo "$TOOLS" | while IFS='|' read -r bin pkg _why; do
        if have_tool "$bin"; then
            printf '  %-20s %s\n' "$bin" "$(tool_version "$bin")"
        else
            printf '  %-20s MISSING (apt-get install %s)\n' "$bin" "$pkg"
        fi
    done
    echo
    echo "toolchain:"
    doctor_toolchain | sed 's/^/  /'
    echo
    echo "capabilities:"
    doctor_caps | sed 's/^/  /'
    echo
    echo "privilege tiers runnable here:"
    _c=$(doctor_caps)
    case "$_c" in *mknod=yes*) _mk=yes ;; *) _mk=no ;; esac
    case "$_c" in *chroot=yes*) _ch=yes ;; *) _ch=no ;; esac
    case "$_c" in *kvm=yes*) _kv=yes ;; *) _kv=no ;; esac
    echo "  privilege: none     yes"
    echo "  privilege: mknod    $_mk"
    if [ "$_ch" = yes ] && [ "$_mk" = yes ]; then echo "  privilege: chroot   yes"
    else echo "  privilege: chroot   no (needs chroot and mknod)"; fi
    if [ "$_kv" = yes ]; then echo "  privilege: kvm      yes"
    elif have qemu-system-x86_64 && [ -e /dev/kvm ]; then
        echo "  privilege: kvm      TCG only (/dev/kvm not writable by this uid; 10-20x slower)"
    elif have qemu-system-x86_64; then echo "  privilege: kvm      TCG only (no /dev/kvm; 10-20x slower)"
    else echo "  privilege: kvm      no (qemu not installed)"; fi
    echo "--- end ---"
}

cmd_doctor() {
    _strict=0
    case "${1:-}" in
        -h|--help) usage_cmd doctor; return 0 ;;
        --report)  doctor_report; return 0 ;;
        --strict)  _strict=1; shift ;;
    esac
    if [ "${1:-}" = "--install-hooks" ]; then
        [ -d "$REPO_ROOT/.git" ] || die "not a git repo: $REPO_ROOT"
        for h in pre-commit pre-push; do
            ln -sf "../../ci/hooks/$h" "$REPO_ROOT/.git/hooks/$h"
            printf '  %sok%s  installed .git/hooks/%s -> ci/hooks/%s\n' "$G" "$O" "$h" "$h"
        done
        printf '%sHooks are symlinks into ci/hooks/, so they follow the repo.%s\n' "$D" "$O"
        return 0
    fi
    printf '%sslax-kitchen doctor%s  (%s)\n\n' "$B" "$O" "$(kitchen_version)"
    DOCTOR_MISSING=0
    doctor_tools
    printf '\n%sToolchain%s\n' "$B" "$O"
    # Captured, not piped straight to sed: a pipeline runs in a subshell, so --strict
    # could not see the result. Same output either way.
    _tc=$(doctor_toolchain)
    printf '%s\n' "$_tc" | sed 's/^/  /'
    doctor_tier "$(doctor_caps)"
    printf '\n%shooks%s  ' "$B" "$O"
    if [ -L "$REPO_ROOT/.git/hooks/pre-commit" ]; then printf '%sinstalled%s\n' "$G" "$O"
    else printf '%snot installed%s  (kitchen doctor --install-hooks)\n' "$Y" "$O"; fi

    # Capabilities are deliberately NOT part of --strict. Missing KVM is a speed
    # problem and missing mount is expected in every container this runs in; a
    # missing tool is a build that will fail later with a worse message.
    if [ "$_strict" = 1 ]; then
        _rc=0
        [ "${DOCTOR_MISSING:-0}" -eq 0 ] || _rc=1
        case "$_tc" in *': NO'*) _rc=1 ;; esac
        if [ "$_rc" -ne 0 ]; then
            printf '\n%s--strict:%s the toolchain is incomplete (see above)\n' "$R" "$O" >&2
        fi
        return "$_rc"
    fi
}

# Detail for one command. The four shell subcommands hand-roll their flag loops and
# used to die on --help ("error: test: unknown option --help"), which is a poor first
# impression and made the issue templates hard to write. The Python commands already
# have argparse, so help_for just forwards to them rather than duplicating their text.
usage_cmd() {
    case "$1" in
      unpack) cat <<'H'
kitchen unpack <iso> [-o DIR]     explode a Slax ISO into a work tree

  -o, --output DIR     where to put it (default: ./work)
  -f, --force          replace an existing work tree, and the record of what was
                       applied to it (<work>/.kitchen)

Records provenance in <work>/.kitchen/origin.yaml, which `kitchen status` reads back.
That includes the image's boot entries: `kitchen pack` warns when a build drops one.
H
        ;;
      pack) cat <<'H'
kitchen pack [-s DIR] [-o FILE]   rebuild an ISO from a work tree

  -s, --source DIR     the iso/ directory to pack (default: work/iso)
  -o, --output FILE    output path (default: ./out/<name>-custom.iso)
  -f, --force          overwrite an existing ISO
      --backend NAME   genisoimage or xorriso (default: genisoimage, or
                       xorriso when --uefi/--hybrid is in play)
      --uefi           add the EFI El Torito alt-boot entry
      --hybrid         add an isohybrid MBR (and a GPT alongside UEFI)
      --volid ID       volume id            --appid ID     application id
      --sysid ID       system id            --publisher S  --preparer S
      --date STAMP     pin the image timestamps, YYYYMMDDhhmmsscc (xorriso only)

Recipes record these as hints in <work>/.kitchen/pack.yaml; a flag given here wins.
Warns when this image will not have a UEFI entry or hybrid MBR the unpacked one had.
Debian status fragments are merged into 98-dpkg-db.sb at this point.
H
        ;;
      build) cat <<'H'
kitchen build <profile> [options]  unpack -> apply -> pack -> test

  --base TARGET        build against a different base than the profile pins,
                       e.g. slackware-64bit-15.0.4 (see compat/sources.yaml)
  --keep               keep the work tree afterwards
  --force              rebuild from scratch, overwriting the work tree and ISO
  --no-test            skip the profile's test list
  --local              run the profile's boot tests here, not on the boot host

<profile> is a name under profiles/ or a path to a Profile YAML.
H
        ;;
      test) cat <<'H'
kitchen test <iso> [options]      assert things about a built ISO

  --structure          structural assertions -- fast, no boot, no mounting
  --kernel             direct kernel boot in QEMU; asserts the livekit markers
  --bios               boot through the BIOS bootloader
  --uefi               boot through GRUB under OVMF
  --usb                boot the image as a usb-storage device (needs isohybrid)
  --persistence        two boots on one disk; a marker written by the first
                       must survive into the second (needs testkit's `marker`)
  --expect STRING      also require STRING in the serial log (repeatable)
  --seconds N          ceiling per boot; with expectations a boot ends as soon
                       as they all appear, so this is a timeout (default: 32)
  --mem MiB            guest memory; a toram run needs at least the image size
  --keys SPEC          menu keystrokes, overriding the derived ones
  --no-keys            do not touch the menu; screenshot evidence only
  --golden FILE        diff the testkit block against FILE
  --record FILE        append one JSON line per boot, for the Tier C ledger
  --perch-device DEV   where perchdir= points, default /dev/sda
  --out DIR            where evidence lands (default: <dir of iso>/boot-tests)
  --expect-uefi        --structure: require an EFI El Torito entry
  --expect-hybrid      --structure: require an isohybrid MBR
  --volid ID           --structure: the volume id to require (default: slax;
                       `kitchen build` passes whatever the recipes asked for)

--kernel needs no help to assert: it builds its own cmdline with ttyS0 as the only
console. The bootloader modes are pointed at a boot entry that names ttyS0 LAST --
found by reading the ISO's own menu -- because /dev/console is the last console= and
everything init prints goes there. Apply `serial-console` to get such an entry. On an
ISO without one these modes fall back to screenshot evidence and say so.

A menu that cannot be read is not a menu without the entry: with a menu that will not
extract, or with an entry whose label cannot be typed, those modes fail and boot nothing.

Every tool the modes you ask for need is checked before any of them runs, and each
missing one is named with its package: xorriso for --structure, the kernel and the
menu; qemu for every boot; mkfs.ext4 for --persistence.

Logs and screenshots land in <dir of iso>/boot-tests/.

  --local              boot here even if boot-host.ini names a machine with KVM

With a boot-host.ini in the repository root, every boot mode above runs on the machine
it names and the evidence still lands here. --structure always runs here: it reads the
image, and the image is already here. See docs/60-testing/boot-host.md.
H
        ;;
      doctor) cat <<'H'
kitchen doctor [options]          what this machine can and cannot build

  --report             one pasteable plain-text block, with tool VERSIONS --
                       this is what a bug report should carry
  --strict             exit 1 if any tool is missing or a toolchain assertion
                       fails -- for CI, which needs doctor to be able to fail
  --install-hooks      symlink .git/hooks/{pre-commit,pre-push} into ci/hooks/

With no options: tools, kernel capabilities, and a summary of which recipe
privilege tiers are runnable here.
H
        ;;
      selftest) cat <<'H'
kitchen selftest [stage] [scope]  run the commit gates

  stage    pre-commit | pre-push | ci        (default: ci)
  scope    staged | tree                     (default: staged for pre-commit,
                                              tree for pre-push and ci)

Every gate runs at every stage; the stage only decides which files they look at.
`kitchen selftest ci` reproduces the CI gates job exactly.
H
        ;;
      version) cat <<'H'
kitchen version                   print the version and git commit

There are no release tags, so the commit comes from `git describe --always --dirty`.
Quote it in bug reports: the version string alone cannot pin a build.
H
        ;;
      *) return 1 ;;
    esac
}

help_for() {
    case "$1" in
      unpack|pack|build|test|doctor|selftest|version) usage_cmd "$1" ;;
      boot-host)           exec python3 "$REPO_ROOT/lib/boot_host.py" --help ;;
      probe|apply|validate|fetch|fingerprint) exec "$REPO_ROOT/lib/$1.py" --help ;;
      status|diff|shell|sources) exec python3 "$REPO_ROOT/lib/$1.py" --help ;;
      upstream-diff)       exec python3 "$REPO_ROOT/lib/upstream_diff.py" --help ;;
      help|--help|-h)      usage ;;
      *) usage; die "unknown command: $1" ;;
    esac
}

# --------------------------------------------------------------- dispatch ----
cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
    doctor)        cmd_doctor "$@" ;;
    # "$@", not "${1:-ci}" -- run-checks.sh takes a second positional (scope) that was
    # being silently dropped, so `kitchen selftest ci staged` ignored the scope.
    selftest)      case "${1:-}" in -h|--help) usage_cmd selftest; exit 0 ;; esac
                   [ $# -gt 0 ] || set -- ci
                   exec "$REPO_ROOT/ci/run-checks.sh" "$@" ;;
    version|--version|-V) printf 'kitchen %s\n' "$(kitchen_version)" ;;
    help|--help|-h)       if [ $# -gt 0 ]; then help_for "$1"; else usage; fi ;;
    '')                   usage ;;
    probe)         exec "$REPO_ROOT/lib/probe.py" "$@" ;;
    apply)         exec "$REPO_ROOT/lib/apply.py" "$@" ;;
    validate)      exec "$REPO_ROOT/lib/validate.py" "$@" ;;
    fetch)         exec "$REPO_ROOT/lib/fetch.py" "$@" ;;
    fingerprint)   exec "$REPO_ROOT/lib/fingerprint.py" "$@" ;;
    unpack)        kitchen_unpack "$@" ;;
    pack)          kitchen_pack "$@" ;;
    build)         kitchen_build "$@" ;;
    test)          kitchen_test "$@" ;;
    boot-host)     python3 "$REPO_ROOT/lib/boot_host.py" "$@" ;;
    status)        python3 "$REPO_ROOT/lib/status.py" "$@" ;;
    diff)          python3 "$REPO_ROOT/lib/diff.py" "$@" ;;
    sources)       python3 "$REPO_ROOT/lib/sources.py" "$@" ;;
    upstream-diff) python3 "$REPO_ROOT/lib/upstream_diff.py" "$@" ;;
    shell)         python3 "$REPO_ROOT/lib/shell.py" "$@" ;;
    *)             usage; die "unknown command: $cmd" ;;
esac
