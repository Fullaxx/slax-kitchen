{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fullaxx/slax-kitchen/schema/recipe.schema.json",
  "title": "slax-kitchen Recipe",
  "description": "A declarative modification to a Slax ISO work tree.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "slax-kitchen/v1"
    },
    "kind": {
      "const": "Recipe"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "must match the filename stem"
        },
        "summary": {
          "type": "string",
          "minLength": 8
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flavours": {
          "type": "array",
          "items": {
            "enum": [
              "debian",
              "slackware"
            ]
          },
          "minItems": 1
        },
        "arch": {
          "type": "array",
          "items": {
            "enum": [
              "32bit",
              "64bit"
            ]
          },
          "minItems": 1
        },
        "slax": {
          "type": "string",
          "description": "semver range, e.g. '>=12.0.0 <13.0.0'"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "recipe names applied before this one"
        },
        "privilege": {
          "enum": [
            "none",
            "mknod",
            "chroot",
            "kvm"
          ],
          "default": "none",
          "description": "none runs anywhere; chroot needs CAP_SYS_ADMIN or proot; kvm is verify-only"
        }
      }
    },
    "vars": {
      "type": "object",
      "description": "substituted into step strings as {{name}}",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "redistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "why"
      ],
      "description": "whether an image built with this recipe may be published at all; `kitchen sources` names every recipe with `allowed: false`",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "why": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "verb"
      ],
      "properties": {
        "verb": {
          "enum": [
            "bundle.fromDir",
            "bundle.fromTarball",
            "bundle.files",
            "bundle.remove",
            "bundle.renumber",
            "bundle.packages",
            "bundle.script",
            "rootcopy.files",
            "rootcopy.preinit",
            "boot.menu",
            "boot.cmdline",
            "boot.branding",
            "boot.payload",
            "boot.uefi",
            "boot.isohybrid",
            "boot.grub",
            "boot.secureboot",
            "initramfs.files",
            "initramfs.modules",
            "initramfs.config",
            "initramfs.patch",
            "initramfs.busybox",
            "kernel.replace",
            "iso.files",
            "iso.metadata",
            "iso.checksums"
          ]
        },
        "when": {
          "type": "string",
          "description": "skip unless this matches, e.g. 'flavour==debian'"
        },
        "network": {
          "type": "boolean",
          "default": false,
          "description": "this step reaches the internet; checked at preflight"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verb": {
                "const": "boot.payload"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "dest"
            ],
            "properties": {
              "src": {
                "type": "string",
                "description": "URL or path relative to the recipe"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "dest": {
                "type": "string",
                "pattern": "^slax/"
              },
              "mode": {
                "type": "string",
                "pattern": "^[0-7]{3,4}$"
              },
              "extract": {
                "type": "string",
                "description": "pull this member out of a downloaded .zip/.tar.*; sha256 is checked against the archive"
              },
              "upstream_source": {
                "description": "where the upstream publishes the source of what this step installs unmodified -- a URL, or several; recorded in the image's provenance and listed by `kitchen sources`",
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^https?://"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "minItems": 1
                  }
                ]
              }
            },
            "dependentRequired": {
              "src": [
                "sha256"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "boot.menu"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "targets": {
                "type": "array",
                "items": {
                  "enum": [
                    "isolinux.cfg",
                    "syslinux.cfg"
                  ]
                },
                "minItems": 1
              },
              "add": {
                "$ref": "#/$defs/menuEntry"
              },
              "remove": {
                "type": "string",
                "description": "LABEL to delete"
              },
              "default": {
                "type": "string"
              },
              "timeout": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "boot.cmdline"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "targets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "which LABELs to touch; omit for all"
              },
              "append": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "remove": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "bundle.remove"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "match"
            ],
            "properties": {
              "match": {
                "type": "string",
                "description": "regex over bundle filenames"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "iso.files"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "files"
            ],
            "properties": {
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "dest"
                  ],
                  "properties": {
                    "src": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    },
                    "dest": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string",
                      "pattern": "^[0-7]{3,4}$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "bundle.packages"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "packages",
              "bundle"
            ],
            "properties": {
              "packages": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "bundle": {
                "type": "string",
                "pattern": "^[0-9]{2}-[a-z0-9][a-z0-9-]*(\\.sb)?$",
                "description": "load order is the numeric prefix; higher wins"
              },
              "from": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "bundles to stack as the build root (default: every bundle that will load below this one)"
              },
              "flavour": {
                "enum": [
                  "debian",
                  "slackware"
                ]
              },
              "apt": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "update": {
                    "type": "boolean",
                    "default": true
                  },
                  "no_recommends": {
                    "type": "boolean",
                    "default": true
                  },
                  "reinstall": {
                    "type": "boolean",
                    "default": false,
                    "description": "pass --reinstall, so packages a stock bundle already has at the same version are unpacked again (their stripped docs come back); files unchanged in size, mtime and mode stay out of the bundle"
                  },
                  "architectures": {
                    "type": "array",
                    "description": "foreign architectures to enable, e.g. [i386] for wine or a 32-bit browser",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    }
                  },
                  "sources": {
                    "type": "array",
                    "description": "third-party apt repositories, for packages Debian does not carry",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "uri",
                        "suite"
                      ],
                      "dependentRequired": {
                        "key_url": [
                          "key_sha256"
                        ]
                      },
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9-]*$"
                        },
                        "uri": {
                          "type": "string",
                          "pattern": "^https?://"
                        },
                        "suite": {
                          "type": "string"
                        },
                        "components": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "default": [
                            "main"
                          ]
                        },
                        "architectures": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "restrict this source to these architectures"
                        },
                        "key_url": {
                          "type": "string",
                          "pattern": "^https?://",
                          "description": "signing key; requires key_sha256"
                        },
                        "key_sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "keep": {
                          "type": "boolean",
                          "default": false,
                          "description": "ship the source and key in the bundle, so the live system trusts the repo and can upgrade from it"
                        },
                        "upstream_source": {
                          "description": "where the upstream publishes the source of what this step installs unmodified -- a URL, or several; recorded in the image's provenance and listed by `kitchen sources`",
                          "oneOf": [
                            {
                              "type": "string",
                              "pattern": "^https?://"
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^https?://"
                              },
                              "minItems": 1
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              },
              "mirror": {
                "type": "string",
                "format": "uri",
                "description": "Slackware only: pin slackpkg to this mirror. The stock config points at slackware64-current, which has moved far past the 2023 base."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "rootcopy.preinit"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "script": {
                "type": "string",
                "description": "inline shell; a #!/bin/sh line is added if absent"
              },
              "src": {
                "type": "string",
                "description": "script file, relative to the recipe"
              }
            },
            "anyOf": [
              {
                "required": [
                  "script"
                ]
              },
              {
                "required": [
                  "src"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "rootcopy.files"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "files"
            ],
            "properties": {
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "dest"
                  ],
                  "properties": {
                    "src": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    },
                    "dest": {
                      "type": "string",
                      "description": "path INSIDE the running system, e.g. /etc/motd"
                    },
                    "mode": {
                      "type": "string",
                      "pattern": "^[0-7]{3,4}$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "bundle.files"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "bundle",
              "files"
            ],
            "properties": {
              "bundle": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "bundle.fromDir"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "bundle",
              "src"
            ],
            "properties": {
              "bundle": {
                "type": "string"
              },
              "src": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "bundle.fromTarball"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "bundle",
              "src"
            ],
            "properties": {
              "bundle": {
                "type": "string"
              },
              "src": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "strip": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "prefix": {
                "type": "string"
              },
              "world_readable": {
                "type": "boolean"
              },
              "upstream_source": {
                "description": "where the upstream publishes the source of what this step installs unmodified -- a URL, or several; recorded in the image's provenance and listed by `kitchen sources`",
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^https?://"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "minItems": 1
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "bundle.renumber"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "match",
              "to"
            ],
            "properties": {
              "match": {
                "type": "string"
              },
              "to": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "bundle.script"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "bundle",
              "script"
            ],
            "properties": {
              "bundle": {
                "type": "string"
              },
              "script": {
                "type": "string"
              },
              "shell": {
                "type": "string"
              },
              "from": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "upstream_source": {
                "description": "where the upstream publishes the source of what this step installs unmodified -- a URL, or several; recorded in the image's provenance and listed by `kitchen sources`",
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^https?://"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "minItems": 1
                  }
                ]
              },
              "declares": {
                "type": "array",
                "description": "binaries this script COMPILES, with the source they were built from; an ELF no package owns and no entry declares makes `kitchen sources` exit 1",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "source_url",
                    "source_sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "description": "path inside the image, no leading slash"
                    },
                    "source_url": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "source_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "license": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "initramfs.files"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "files"
            ],
            "properties": {
              "files": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "force": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "initramfs.modules"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "modules"
            ],
            "properties": {
              "modules": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "from_bundle": {
                "type": "string"
              },
              "subdir": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "initramfs.patch"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "edits"
            ],
            "properties": {
              "edits": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "initramfs.busybox"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "src": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "boot.branding"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "targets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default": {
                "type": "string"
              },
              "timeout": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "help": {
                "type": "string"
              },
              "bootlogo": {
                "description": "menu background; a path, or {src: path}",
                "type": [
                  "string",
                  "object"
                ]
              },
              "helpbg": {
                "description": "background behind the F1 screen; a path, or {src: path}",
                "type": [
                  "string",
                  "object"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "boot.grub"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "dest": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "probe": {
                "description": "file `search --file` looks for; default /slax/boot/vmlinuz",
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "boot.uefi"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "timeout": {
                "description": "seconds GRUB waits before the default entry; default 5",
                "type": [
                  "integer",
                  "string"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "boot.isohybrid"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {}
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "iso.metadata"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "volid": {
                "type": "string"
              },
              "appid": {
                "type": "string"
              },
              "sysid": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "preparer": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "iso.checksums"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "type": "string"
              },
              "sign": {
                "description": "gpg key id to detach-sign the checksum file with; false disables",
                "type": [
                  "string",
                  "boolean"
                ]
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "menuEntry": {
      "type": "object",
      "required": [
        "label",
        "menu_label"
      ],
      "properties": {
