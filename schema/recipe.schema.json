{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fullaxx/slax-kitchen/schema/recipe.schema.json",
  "title": "slax-kitchen Recipe",
  "description": "A declarative modification to a Slax ISO work tree.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "slax-kitchen/v1"
    },
    "kind": {
      "const": "Recipe"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "must match the filename stem"
        },
        "summary": {
          "type": "string",
          "minLength": 8
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flavours": {
          "type": "array",
          "items": {
            "enum": [
              "debian",
              "slackware"
            ]
          },
          "minItems": 1
        },
        "arch": {
          "type": "array",
          "items": {
            "enum": [
              "32bit",
              "64bit"
            ]
          },
          "minItems": 1
        },
        "slax": {
          "type": "string",
          "description": "semver range, e.g. '>=12.0.0 <13.0.0'"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "recipe names applied before this one"
        },
        "privilege": {
          "enum": [
            "none",
            "mknod",
            "chroot",
            "kvm"
          ],
          "default": "none",
          "description": "none runs anywhere; chroot needs CAP_SYS_ADMIN or proot; kvm is verify-only"
        }
      }
    },
    "vars": {
      "type": "object",
      "description": "substituted into step strings as {{name}}",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "verb"
      ],
      "properties": {
        "verb": {
          "enum": [
            "bundle.fromDir",
            "bundle.fromTarball",
            "bundle.files",
            "bundle.remove",
            "bundle.renumber",
            "bundle.packages",
            "bundle.script",
            "rootcopy.files",
            "rootcopy.preinit",
            "boot.menu",
            "boot.cmdline",
            "boot.branding",
            "boot.payload",
            "boot.uefi",
            "boot.isohybrid",
            "boot.grub",
            "boot.secureboot",
            "initramfs.files",
            "initramfs.modules",
            "initramfs.config",
            "initramfs.patch",
            "initramfs.busybox",
            "kernel.replace",
            "iso.files",
            "iso.metadata",
            "iso.checksums"
          ]
        },
        "when": {
          "type": "string",
          "description": "skip unless this matches, e.g. 'flavour==debian'"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verb": {
                "const": "boot.payload"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "dest"
            ],
            "properties": {
              "src": {
                "type": "string",
                "description": "URL or path relative to the recipe"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "dest": {
                "type": "string",
                "pattern": "^slax/"
              },
              "mode": {
                "type": "string",
                "pattern": "^[0-7]{3,4}$"
              },
              "extract": {
                "type": "string",
                "description": "pull this member out of a downloaded .zip/.tar.*; sha256 is checked against the archive"
              }
            },
            "dependentRequired": {
              "src": [
                "sha256"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "boot.menu"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "targets": {
                "type": "array",
                "items": {
                  "enum": [
                    "isolinux.cfg",
                    "syslinux.cfg"
                  ]
                },
                "minItems": 1
              },
              "add": {
                "$ref": "#/$defs/menuEntry"
              },
              "remove": {
                "type": "string",
                "description": "LABEL to delete"
              },
              "default": {
                "type": "string"
              },
              "timeout": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "boot.cmdline"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "targets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "which LABELs to touch; omit for all"
              },
              "append": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "remove": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "bundle.remove"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "match"
            ],
            "properties": {
              "match": {
                "type": "string",
                "description": "regex over bundle filenames"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "iso.files"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "files"
            ],
            "properties": {
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "dest"
                  ],
                  "properties": {
                    "src": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    },
                    "dest": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string",
                      "pattern": "^[0-7]{3,4}$"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "bundle.packages"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "packages",
              "bundle"
            ],
            "properties": {
              "packages": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "bundle": {
                "type": "string",
                "pattern": "^[0-9]{2}-[a-z0-9][a-z0-9-]*(\\.sb)?$",
                "description": "load order is the numeric prefix; higher wins"
              },
              "from": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "bundles to stack as the build root (default 01-core)"
              },
              "flavour": {
                "enum": [
                  "debian",
                  "slackware"
                ]
              },
              "apt": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "update": {
                    "type": "boolean",
                    "default": true
                  },
                  "no_recommends": {
                    "type": "boolean",
                    "default": true
                  }
                }
              },
              "mirror": {
                "type": "string",
                "format": "uri",
                "description": "Slackware only: pin slackpkg to this mirror. The stock config points at slackware64-current, which has moved far past the 2023 base."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "rootcopy.preinit"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "properties": {
              "script": {
                "type": "string",
                "description": "inline shell; a #!/bin/sh line is added if absent"
              },
              "src": {
                "type": "string",
                "description": "script file, relative to the recipe"
              }
            },
            "anyOf": [
              {
                "required": [
                  "script"
                ]
              },
              {
                "required": [
                  "src"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verb": {
                "const": "rootcopy.files"
              }
            },
            "required": [
              "verb"
            ]
          },
          "then": {
            "required": [
              "files"
            ],
            "properties": {
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "dest"
                  ],
                  "properties": {
                    "src": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    },
                    "dest": {
                      "type": "string",
                      "description": "path INSIDE the running system, e.g. /etc/motd"
                    },
                    "mode": {
                      "type": "string",
                      "pattern": "^[0-7]{3,4}$"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "menuEntry": {
      "type": "object",
      "required": [
        "label",
        "menu_label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "menu_label": {
          "type": "string"
        },
        "kernel": {
          "type": "string"
        },
        "linux": {
          "type": "string"
        },
        "com32": {
          "type": "string"
        },
        "initrd": {
          "type": "string"
        },
        "append": {
          "type": "string"
        },
        "position": {
          "enum": [
            "top",
            "bottom"
          ],
          "default": "bottom"
        }
      }
    }
  }
}
