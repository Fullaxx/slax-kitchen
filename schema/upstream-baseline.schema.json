{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fullaxx/slax-kitchen/schema/upstream-baseline.schema.json",
  "title": "slax-kitchen upstream baseline",
  "type": "object",
  "required": ["apiVersion", "kind", "linux_live_head", "latest_releases"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "slax-kitchen/v1" },
    "kind": { "const": "UpstreamBaseline" },
    "linux_live_head": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "linux_live_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "latest_releases": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
      "description": "one per release line; Slax ships two, one per flavour"
    },
    "latest_release_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
