{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fullaxx/slax-kitchen/schema/profile.schema.json",
  "title": "slax-kitchen Profile",
  "description": "One build: a base ISO plus an ordered list of recipes.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "base",
    "recipes"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "slax-kitchen/v1"
    },
    "kind": {
      "const": "Profile"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "flavour",
        "arch",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "flavour": {
          "enum": [
            "debian",
            "slackware"
          ]
        },
        "arch": {
          "enum": [
            "32bit",
            "64bit"
          ]
        },
        "version": {
          "type": "string"
        },
        "iso": {
          "type": "string",
          "description": "explicit path, relative to the repository that holds the profile; otherwise kitchen fetch"
        }
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "description": "recipes to apply, in order. A bare name (or path) uses the recipe's own vars; the object form overrides them for this build.",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "recipe name, or a path to a recipe file"
          },
          {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "recipe name, or a path to a recipe file; vars reach the recipe either way"
              },
              "vars": {
                "type": "object",
                "description": "override the recipe's vars for this build; a name the recipe does not declare is an error",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "hybrid": {
          "type": "boolean",
          "default": false
        },
        "backend": {
          "enum": [
            "genisoimage",
            "xorriso"
          ]
        }
      }
    },
    "test": {
      "type": "array",
      "items": {
        "enum": [
          "structure",
          "kernel-boot",
          "bios-boot",
          "uefi-boot",
          "usb",
          "persistence"
        ]
      }
    }
  }
}
